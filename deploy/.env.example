# Deployment environment — copy to deploy/.env and replace CHANGE_ME values.
# Never commit deploy/.env (real secrets).

# ---------- PostgreSQL (deployment creds — not admitto/admitto) ----------
POSTGRES_USER=admitto_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=admitto

# App connection (host `db` is the compose service name)
DATABASE_URL=postgresql://admitto_app:CHANGE_ME@db:5432/admitto

# ---------- Redis ----------
# Generate with: openssl rand -hex 32
# docker-compose.yml requires REDIS_PASSWORD and sets app REDIS_URL from it (REDIS_URL below is for reference / smoke only).
REDIS_PASSWORD=CHANGE_ME
REDIS_URL=redis://:CHANGE_ME@redis:6379

# ---------- App (required in production) ----------
NODE_ENV=production
PORT=3000
TRUST_PROXY=true
# X-Forwarded-For/Host/Proto are honoured only from a peer inside this range — the compose
# `proxy` container, on the `internal` network's fixed subnet (see docker-compose.yml). Widen
# only if you added another trusted hop between compose nginx and the app.
TRUSTED_PROXY_CIDRS=172.28.238.0/24
BASE_URL=https://tickets.example.com

# Optional: pull a release image from ghcr.io instead of building locally.
# Must match a published git tag (without the leading v). CI publishes on every v* tag.
# ADMITTO_IMAGE=ghcr.io/solarssk/admitto:0.3.6

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME

# Bounce / NDR IMAP ingest wake tick (seconds). Default 60.
# Per-event Check every (poll_interval_minutes) decides when each event is due.
# Legacy alias: BOUNCE_INGEST_INTERVAL_SECONDS (same meaning as the tick).
# BOUNCE_INGEST_TICK_SECONDS=60

# Fail import_commit / export AdminJobs stuck in running after worker crash (ms since started_at).
# Default 900000 (15 minutes). Align with the admin Import/Export poll budget so a dead
# worker surfaces as a failed job in the same wait, not only later in history.
# IMPORT_JOB_STALE_RUNNING_MS=900000
# EXPORT_JOB_STALE_RUNNING_MS=900000

# Emergency break-glass only (default off)
ALLOW_CHECKIN_BEARER=false
CHECKIN_OPERATOR_TOKEN=

# HTTP access log on app stdout (deploy compose defaults this to 1).
# One JSON line per request: method, redacted path, status, duration_ms.
# Never logs IPs, user agents, cookies, query strings, or ticket/QR tokens.
# LOG_HTTP_REQUESTS=1

# Detailed readiness for Uptime Kuma (ADR 0026). Enables GET /readyz when set (minimum 32 characters).
# Also authorizes POST /api/ops/system-logs for the worker bounce → System Logs bridge.
# Send as Authorization: Bearer <token> or X-Ops-Token. Unset or too short = endpoint disabled (404).
# Generate with: openssl rand -hex 32
OPS_HEALTH_TOKEN=

# Internal app URL for worker bounce ingest → System Logs (compose sets http://app:3000).
# BOUNCE_INGEST_APP_URL=http://app:3000

# ---------- Mail (choose ONE provider section) ----------
# Default production path: SMTP relay (ADR 0029). Examples: Microsoft 365 SMTP, Amazon SES,
# SendGrid, Mailgun, Postfix, or your organisation's corporate relay. Graph or Power Automate
# = alternatives per deployment.
EMAIL_PROVIDER=smtp
# export_only — dev/test dry-run only; requires a runtime exportSink (wired in npm run dev).
# Cannot send in production without a sink — use smtp, graph, or powerautomate instead.
MAIL_FROM_ADDRESS=events@example.com
MAIL_FROM_NAME="Admitto Events"
MAIL_REPLY_TO=
MAIL_ENVELOPE_FROM=

# POWER AUTOMATE
POWER_AUTOMATE_URL=
POWER_AUTOMATE_KEY=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_HELO_NAME=
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES_PER_CONNECTION=100
SMTP_RATE_LIMIT_PER_MINUTE=30
SMTP_CONNECTION_TIMEOUT=30000
SMTP_GREETING_TIMEOUT=30000
SMTP_SOCKET_TIMEOUT=60000

# MICROSOFT GRAPH
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_SAVE_TO_SENT=true

# ---------- Cloudflare Access (optional — configure via Settings → Identity) ----------
# Uncomment only when you intentionally want env locks (UI fields become read-only).
# CF_ACCESS_ENABLED=true
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-tag
# CF_ACCESS_PROTECTED_PREFIXES=["/admin","/api/admin"]

# ---------- Optional session / MFA overrides ----------
# SESSION_TTL_OPERATOR_MS=43200000
# For deployments where OIDC group mappings grant admin/superadmin roles, set
# admin TTL to 8h or less so IdP removals have a bounded stale-session window.
# SESSION_TTL_ADMIN_MS=28800000
# If unset, the application default is 43200000 (12 hours) for both roles.
# Idle timeout — ends a `full` session after this much inactivity, well before the absolute
# TTL above is reached. Must not exceed the matching TTL above (rejected by the admin API).
# If unset, the application default is 1800000 (30 min) admin / 7200000 (2h) operator.
# SESSION_IDLE_TIMEOUT_ADMIN_MS=1800000
# SESSION_IDLE_TIMEOUT_OPERATOR_MS=7200000
# TRUSTED_DEVICE_DAYS=30
# MFA_REQUIRED_ROLES=admin,superadmin

# ---------- Branding uploads ----------
# Compose bind-mounts ./uploads → /app/uploads (UPLOAD_DIR). Orphan GC (manual / external cron):
#   docker compose exec app node apps/cli/dist/index.js storage gc --operator-email you@example.com [--dry-run]
# UPLOAD_DIR=/app/uploads
# STORAGE_PROVIDER=local

# ---------- Optional data retention overrides ----------
# EMAIL_DELIVERY_SNAPSHOT_RETENTION_DAYS=60   # nullify rendered_html/subject on terminal deliveries
# SECURITY_AUDIT_LOG_RETENTION_DAYS=30        # purge durable auth/security event rows (issue #473)

# ---------- OIDC (optional env seed; production via admin UI) ----------
# OIDC_ENABLED=false
# OIDC_ISSUER=https://auth.example.com/application/o/admitto/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Corporate SSO
