# Deployment environment — copy to deploy/.env and replace CHANGE_ME values.
# Never commit deploy/.env (real secrets).

# ---------- PostgreSQL (deployment creds — not admitto/admitto) ----------
POSTGRES_USER=admitto_app
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=admitto

# App connection (host `db` is the compose service name)
DATABASE_URL=postgresql://admitto_app:CHANGE_ME@db:5432/admitto

# ---------- Redis ----------
REDIS_URL=redis://redis:6379

# ---------- App (required in production) ----------
NODE_ENV=production
PORT=3000
TRUST_PROXY=true
BASE_URL=https://tickets.example.com

# Optional: pull a release image from ghcr.io instead of building locally.
# Must match a published git tag (without the leading v). CI publishes on every v* tag.
# ADMITTO_IMAGE=ghcr.io/solarssk/admitto:0.3.6

# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=CHANGE_ME

# Emergency break-glass only (default off)
ALLOW_CHECKIN_BEARER=false
CHECKIN_OPERATOR_TOKEN=

# Detailed readiness for Uptime Kuma (ADR 0026). Enables GET /readyz when set (minimum 32 characters).
# Send as Authorization: Bearer <token> or X-Ops-Token. Unset or too short = endpoint disabled (404).
# Generate with: openssl rand -hex 32
OPS_HEALTH_TOKEN=

# ---------- Mail (choose ONE provider section) ----------
# Default: DuoCircle SMTP relay (ADR 0029). Power Automate = fallback when SMTP is blocked.
EMAIL_PROVIDER=smtp
# export_only — dev/test dry-run only; requires a runtime exportSink (wired in npm run dev).
# Cannot send in production without a sink — use smtp, graph, or powerautomate instead.
MAIL_FROM_ADDRESS=events@example.com
MAIL_FROM_NAME="Admitto Events"
MAIL_REPLY_TO=
MAIL_ENVELOPE_FROM=

# POWER AUTOMATE
POWER_AUTOMATE_URL=
POWER_AUTOMATE_KEY=

# SMTP
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_REQUIRE_TLS=true
SMTP_TLS_REJECT_UNAUTHORIZED=true
SMTP_HELO_NAME=
SMTP_POOL=true
SMTP_MAX_CONNECTIONS=3
SMTP_MAX_MESSAGES_PER_CONNECTION=100
SMTP_RATE_LIMIT_PER_MINUTE=30
SMTP_CONNECTION_TIMEOUT=30000
SMTP_GREETING_TIMEOUT=30000
SMTP_SOCKET_TIMEOUT=60000

# MICROSOFT GRAPH
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_MAILBOX=
GRAPH_SAVE_TO_SENT=true

# ---------- Cloudflare Access (optional — configure via /admin/auth/cf-access) ----------
# Uncomment only when you intentionally want env locks (UI fields become read-only).
# CF_ACCESS_ENABLED=true
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-tag
# CF_ACCESS_PROTECTED_PREFIXES=["/admin","/api/admin"]

# ---------- Optional session / MFA overrides ----------
# SESSION_TTL_OPERATOR_MS=43200000
# SESSION_TTL_ADMIN_MS=604800000
# TRUSTED_DEVICE_DAYS=30
# MFA_REQUIRED_ROLES=admin,superadmin

# ---------- OIDC (optional env seed; production via admin UI) ----------
# OIDC_ENABLED=false
# OIDC_ISSUER=https://auth.example.com/application/o/admitto/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Corporate SSO
