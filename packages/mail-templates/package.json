{
  "name": "@admitto/mail-templates",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto mail templates — Outlook-safe renderer, MJML compile, per-scope storage",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./placeholders": {
      "types": "./dist/placeholders.d.ts",
      "default": "./dist/placeholders.js"
    },
    "./branding": {
      "types": "./dist/branding.d.ts",
      "default": "./dist/branding.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/db",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@admitto/db": "*",
    "@admitto/location": "*",
    "mjml": "^5.4.0"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/mjml": "^5.0.0",
    "@types/node": "^26.2.0",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
