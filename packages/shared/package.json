{
  "name": "@admitto/shared",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto shared utilities — neutral helpers, dependency-free except the ./pinned-dispatcher subpath (undici)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./ssrf-guard": {
      "types": "./dist/ssrfGuard.d.ts",
      "default": "./dist/ssrfGuard.js"
    },
    "./system-log": {
      "types": "./dist/systemLog.d.ts",
      "default": "./dist/systemLog.js"
    },
    "./load-env-file": {
      "types": "./dist/loadEnvFile.d.ts",
      "default": "./dist/loadEnvFile.js"
    },
    "./pinned-dispatcher": {
      "types": "./dist/pinnedDispatcher.d.ts",
      "default": "./dist/pinnedDispatcher.js"
    },
    "./sse-events": {
      "types": "./dist/sseEvents.d.ts",
      "default": "./dist/sseEvents.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "prepare": "tsc -p tsconfig.json",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
