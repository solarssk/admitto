{
  "name": "@admitto/import",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto attendee import — CSV parser, validator, and DB commit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/shared -w @admitto/crypto -w @admitto/db -w @admitto/mail-templates -w @admitto/tickets -w @admitto/auth -w @admitto/storage",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "import": "tsx src/cli.ts"
  },
  "dependencies": {
    "@admitto/crypto": "*",
    "@admitto/db": "*",
    "@admitto/shared": "*",
    "@admitto/storage": "*",
    "@admitto/tickets": "*",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/node": "^24.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
