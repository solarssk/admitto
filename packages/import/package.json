{
  "name": "@admitto/import",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto attendee import — CSV parser, validator, and DB commit",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "import": "tsx src/cli.ts"
  },
  "dependencies": {
    "@admitto/db": "*",
    "@admitto/shared": "*",
    "@admitto/tickets": "*",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@prisma/client": "^5.17.0",
    "@types/node": "^22.19.20",
    "prisma": "^5.17.0",
    "tsx": "^4.16.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  }
}
