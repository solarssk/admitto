{
  "name": "@admitto/db",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto DB — Prisma schema + client (PostgreSQL)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "default": "./dist/client.js"
    },
    "./status": {
      "types": "./dist/status.d.ts",
      "default": "./dist/status.js"
    },
    "./test-db-guard": {
      "types": "./dist/testDbGuard.d.ts",
      "default": "./dist/testDbGuard.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/shared && npm run build",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "postinstall": "prisma generate",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy && tsx src/scripts/backfill-public-ref.ts && tsx src/scripts/backfill-event-custom-fields.ts && tsx src/scripts/backfill-ticket-types.ts && tsx src/scripts/backfill-checkin-session-id.ts && tsx src/scripts/backfill-event-actor-attribution.ts",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:status": "prisma migrate status",
    "predb:seed": "npm run build --workspace=@admitto/crypto",
    "db:seed": "prisma db seed",
    "db:backfill-public-ref": "tsx src/scripts/backfill-public-ref.ts",
    "db:backfill-event-custom-fields": "tsx src/scripts/backfill-event-custom-fields.ts",
    "db:backfill-ticket-types": "tsx src/scripts/backfill-ticket-types.ts"
  },
  "dependencies": {
    "@admitto/crypto": "*",
    "@admitto/shared": "*",
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prisma": "^7.9.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.9"
  }
}
