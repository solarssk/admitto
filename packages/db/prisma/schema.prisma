// PostgreSQL is the single database engine (dev, CI, prod) — see ADR 0004.
// No Prisma enums — statuses as String + TS unions in src/status.ts.
// Tenant boundary: Organization (ADR 0005). Roles: RoleAssignment (exact-match, ADR 0005).
// Encryption: Attendee.token_enc AES-256-GCM via @admitto/crypto (ADR 0006).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id               String          @id @default(cuid())
  name             String
  slug             String          @unique
  // Branding URLs (ADR 0008) — external hosted images, not uploads.
  logo_url         String?
  header_image_url String?
  created_at       DateTime        @default(now())
  events           Event[]
  email_deliveries EmailDelivery[]
}

model Event {
  id               String       @id @default(cuid())
  organization_id  String
  organization     Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  title            String
  slug             String       @unique
  date             DateTime
  location         String?
  logo_url         String?
  header_image_url String?
  created_at       DateTime     @default(now())
  attendees        Attendee[]
  check_ins        CheckIn[]

  @@index([organization_id])
}

model Attendee {
  id               String          @id @default(cuid())
  event_id         String
  event            Event           @relation(fields: [event_id], references: [id])
  email            String
  name             String
  // SHA-256(raw_token) for Mode A tickets; null for Mode B (agency) attendees.
  // Raw token never stored — exists only in the ticket URL / QR handed to the attendee.
  token_hash       String?         @unique
  // AES-256-GCM encrypted raw ticket token (for same-link resend — ADR 0006).
  // Null for Mode B (agency) attendees; null for unissued Mode A attendees.
  token_enc        String?
  // Agency-provided QR payload preserved as source of truth for import.
  qr_payload       String?
  external_uuid    String?
  ticket_type      String?
  company          String?
  department       String?
  status           String          @default("registered")
  // Set atomically on first VALID check-in (CAS WHERE admitted_at IS NULL).
  // Null = not yet admitted. Reset only by explicit admin revert action.
  admitted_at      DateTime?
  admitted_by      String?
  created_at       DateTime        @default(now())
  email_deliveries EmailDelivery[]
  wallet_pass      WalletPass?
  check_ins        CheckIn[]

  @@unique([event_id, email])
  // Enforce agency-UUID uniqueness per event for idempotent re-import.
  // NULL external_uuid is allowed for multiple rows (NULLs are not equal in SQL).
  @@unique([event_id, external_uuid])
  // Agency QR payloads must resolve to at most one attendee per event.
  // NULL qr_payload is allowed for multiple internal attendees.
  @@unique([event_id, qr_payload])
  // Composite key for CheckIn FK — attendee_id + event_id must match the same row.
  @@unique([id, event_id])
  @@index([external_uuid])
}

model WalletPass {
  id            String   @id @default(cuid())
  attendee_id   String   @unique
  attendee      Attendee @relation(fields: [attendee_id], references: [id])
  pass_type_id  String
  serial_number String
  auth_token    String
  pass_url      String?
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model EmailDelivery {
  id              String       @id @default(cuid())
  organization_id String
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  attendee_id     String
  attendee        Attendee     @relation(fields: [attendee_id], references: [id])
  provider        String
  message_id      String?
  status          String       @default("pending")
  sent_at         DateTime?
  created_at      DateTime     @default(now())

  @@index([organization_id])
}

model CheckIn {
  id            String   @id @default(cuid())
  attendee_id   String
  event_id      String
  attendee      Attendee @relation(fields: [attendee_id, event_id], references: [id, event_id])
  event         Event    @relation(fields: [event_id], references: [id])
  checked_in_at DateTime @default(now())
  // CheckInStatus values — see src/status.ts.
  status        String   @default("VALID")
  checked_in_by String?
  source        String?
  notes         String?
  device_id     String?
  created_at    DateTime @default(now())

  @@index([event_id, checked_in_at(sort: Desc), id(sort: Desc)])
}

// Per-scope mailer configuration (ADR 0005, ADR 0006).
// scope_type = "organization" | "event". Secrets stored encrypted via @admitto/crypto.
model MailSettings {
  id         String   @id @default(cuid())
  scope_type String   // "organization" | "event"
  scope_id   String

  // Provider (plain)
  provider String? // "graph" | "smtp" | "powerautomate" | "export_only"

  // SMTP non-secret fields
  host                    String?
  port                    Int?
  secure                  Boolean?
  user                    String?
  require_tls             Boolean?
  tls_reject_unauthorized Boolean?
  helo_name               String?
  pool                    Boolean?
  max_connections         Int?
  max_messages            Int?
  rate_limit_per_minute   Int?
  connection_timeout      Int?
  greeting_timeout        Int?
  socket_timeout          Int?

  // Graph non-secret fields
  mailbox            String?
  tenant_id          String?
  client_id          String?
  save_to_sent_items Boolean?

  // Shared sender model (non-secret)
  from_address        String?
  from_name           String?
  reply_to            String?
  envelope_from       String?
  allowed_from_domain String?

  // Encrypted secrets (AES-256-GCM via @admitto/crypto — never store plaintext)
  smtp_password_enc       String?
  graph_client_secret_enc String?
  power_automate_key_enc  String?
  power_automate_url_enc  String? // PA url is treated as a secret (contains sig token)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([scope_type, scope_id])
}

// Per-scope mail template storage (plain text — not encrypted).
model MailTemplate {
  id                     String   @id @default(cuid())
  scope_type             String   // "organization" | "event"
  scope_id               String
  subject_template       String
  body_template          String   @db.Text
  template_format        String   // "mjml" | "html"
  compiled_html_template String   @db.Text
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  @@unique([scope_type, scope_id])
}

model RoleAssignment {
  id         String   @id @default(cuid())
  user_ref   String   // placeholder for future IdP mapping (OIDC/SAML — v1.0)
  role       String   // "superadmin" | "admin" | "operator"
  scope_type String   // "instance" | "organization" | "event"
  scope_id   String?  // null for instance scope
  created_at DateTime @default(now())

  @@index([user_ref])
  @@index([scope_type, scope_id])
}
