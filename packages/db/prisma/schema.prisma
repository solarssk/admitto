// PostgreSQL is the single database engine (dev, CI, prod) — see ADR 0004.
// No Prisma enums — statuses as String + TS unions in src/status.ts.
// Tenant boundary: Organization (ADR 0005). Roles: RoleAssignment (exact-match, ADR 0005).
// Encryption: Attendee.token_enc AES-256-GCM via @admitto/crypto (ADR 0006).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Organization {
  id                    String          @id @default(cuid())
  name                  String
  slug                  String          @unique
  // Branding URLs (ADR 0008) — external hosted images, not uploads.
  logo_url              String?
  // Full pre-crop file for re-Edit; display still uses logo_url (cropped).
  logo_original_url     String?
  // Percent crop + zoom last applied: { unit:"%", x, y, width, height, zoom }.
  logo_crop             Json?
  header_image_url      String?
  // Reserved for future use, e.g. identifying this instance in outbound API requests.
  support_contact_name  String?
  support_contact_email String?
  created_at            DateTime        @default(now())
  events                Event[]
  email_deliveries      EmailDelivery[]
}

model Event {
  id                   String              @id @default(cuid())
  organization_id      String
  organization         Organization        @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  title                String
  slug                 String              @unique
  date                 DateTime
  // Display-only "HH:MM" 24h range shown on tickets/wallet passes; Event.date has no time-range
  // field of its own. Independently optional - the admin UI pairs them but neither is required.
  event_hours_start    String?
  event_hours_end      String?
  timezone             String              @default("UTC")
  capacity             Int?
  logo_url             String?
  // Full pre-crop file for re-Edit; display still uses logo_url (cropped).
  logo_original_url    String?
  // Percent crop + zoom last applied: { unit:"%", x, y, width, height, zoom }.
  logo_crop            Json?
  header_image_url     String?
  created_at           DateTime            @default(now())
  // No FK (matches AdminAuditLog.actor_user_id) - a deactivated/deleted user must not block
  // reads of the event they created/archived. Null for historical rows predating this column;
  // backfilled best-effort from AdminAuditLog where a matching event_created/event_archived
  // entry exists (see backfill-event-actor-attribution.ts).
  created_by_user_id   String?
  // Actor's IANA timezone at the moment of the matching action - mirrors AdminAuditLog.
  // actor_timezone/AttendeeActionLog.client_timezone. Null for rows predating this column, a
  // non-browser actor (CLI), or where backfill found no matching audit entry.
  created_by_timezone  String?
  archived_at          DateTime?
  archived_by_user_id  String?
  archived_by_timezone String?
  // Event-day ops (ADR 0010): require_confirm_on_scan, badge_at_entry, etc.
  ops_config           Json?
  // Single operational sticky note shown on the overview page to all staff.
  pinned_note          String?             @db.Text
  attendees            Attendee[]
  check_ins            CheckIn[]
  email_deliveries     EmailDelivery[]
  event_items          EventItem[]
  attendee_notes       AttendeeNote[]
  action_logs          AttendeeActionLog[]
  contacts             EventContact[]
  resources            EventResource[]
  image_assets         EventImageAsset[]
  custom_fields        EventCustomField[]
  ticket_types                   TicketType[]
  location_details               EventLocation?
  bounce_ingest_settings         BounceIngestSettings?
  bounce_ingest_processed_uids   BounceIngestProcessedUid[]
  bounce_ingest_runs             BounceIngestRun[]

  @@index([organization_id])
  @@index([organization_id, archived_at])
}

model EventContact {
  id         String   @id @default(cuid())
  event_id   String
  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  name       String
  role       String?
  phone      String?
  email      String?
  note       String?
  sort_order Int      @default(0)
  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@index([event_id, sort_order])
}

model EventResource {
  id          String            @id @default(cuid())
  event_id    String
  event       Event             @relation(fields: [event_id], references: [id], onDelete: Cascade)
  title       String
  type        EventResourceType @default(link)
  url         String
  description String?
  sort_order  Int               @default(0)
  created_at  DateTime          @default(now())
  updated_at  DateTime          @updatedAt

  @@index([event_id, sort_order])
}

// Named image assets uploaded per event (branding "asset library" — v0.4.13 batch 05). Each
// gets a short {{token}} usable in Communication email templates (see @admitto/mail-templates
// placeholders.ts), resolved to `url` at render time exactly like the built-in
// logo_url/header_image_url. Distinct from Event.logo_url/header_image_url, which remain
// dedicated override fields (resolved event -> organization -> empty) - this table is purely
// for ad-hoc images referenced by name in emails, no fallback/inheritance semantics.
model EventImageAsset {
  id         String   @id @default(cuid())
  event_id   String
  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  token      String
  filename   String
  url        String
  size_bytes Int
  mime_type  String
  created_at DateTime @default(now())

  @@unique([event_id, token])
  @@index([event_id])
}

// Registry of arbitrary attendee attributes an event wants to collect (dietary, shirt size,
// parking, ...) - the single source of truth for a field's definition. Replaces the old model
// where a field only existed as a `contents` row embedded in some EventItem.config (ADR 0025);
// an EventItem now only holds `content_fields: string[]` referencing rows here, used purely to
// say "show this field as an operator hint on this item" (packages/tickets/event-item-contents.ts).
model EventCustomField {
  id           String   @id @default(cuid())
  event_id     String
  event        Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  source_field String
  label        String
  description  String?
  type         String   @default("text")
  options      Json?
  required     Boolean  @default(false)
  created_at   DateTime @default(now())
  updated_at   DateTime @updatedAt

  @@unique([event_id, source_field])
  @@index([event_id])
}

// Event Settings "Location" tab (1:1 with Event) - the venue's short display name, full address,
// map coordinates, and free-text directions/accessibility notes. This is now the single source of
// truth for an event's location (shown on the event list/card and in ticket emails via
// `venue_name`) - the former separate `Event.location` text field was removed to eliminate a
// duplicate "where is this event" input (previously one in Basic Information, one here).
// `latitude`/`longitude` are both-or-neither (see assertCoordinatePairing in @admitto/location) -
// checked again at the DB layer below.
model EventLocation {
  id                 String    @id @default(cuid())
  event_id           String    @unique
  event              Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  // Short display name (e.g. "National Stadium") - picked from a geocoding suggestion or typed
  // free-text. Mirrors the old Event.location in meaning/limits (trimmed, max 300 chars).
  venue_name         String?
  formatted_address  String?
  latitude           Float?
  longitude          Float?
  map_zoom           Int       @default(15)
  directions_text    String?   @db.Text
  accessibility_text String?   @db.Text
  // Plain string, not a Prisma enum (see header comment) - e.g. "nominatim".
  geocoding_provider String?
  geocoded_at        DateTime?
  // Structured address grid from the last geocode/reverse (object_name, street, postcode,
  // city, region, country). Null when never set or cleared with the map pin.
  address_components Json?
  // Manual deep-link overrides when the lat/lng-built Google/Apple URL opens the wrong place.
  // Null = build from coordinates as usual. Does not move the OSM pin or static map.
  google_maps_url_override String? @db.Text
  apple_maps_url_override  String? @db.Text
  created_at         DateTime  @default(now())
  updated_at         DateTime  @updatedAt
}

// Per-event catalog of ticket types (batch 04 / #351) - replaces free-text Attendee.ticket_type.
// `key` is immutable after create (slugified from `label`) since it's what Attendee.ticket_type
// stores; renaming it would desync every attendee row already tagged with it. `color` is one of
// the curated palette keys in TICKET_TYPE_COLORS (packages/ui) - admin-assignable, not a fixed enum.
model TicketType {
  id         String     @id @default(cuid())
  event_id   String
  event      Event      @relation(fields: [event_id], references: [id], onDelete: Cascade)
  key        String
  label      String
  color      String     @default("gray")
  sort_order Int        @default(0)
  created_at DateTime   @default(now())
  updated_at DateTime   @updatedAt
  attendees  Attendee[]

  @@unique([event_id, key])
  @@index([event_id])
}

enum EventResourceType {
  link
  file
}

model Attendee {
  id                  String              @id @default(cuid())
  event_id            String
  event               Event               @relation(fields: [event_id], references: [id])
  email               String
  name                String
  // SHA-256(raw_token) for Mode A tickets; null for Mode B (agency) attendees.
  // Raw token never stored — exists only in the ticket URL / QR handed to the attendee.
  token_hash          String?             @unique
  // AES-256-GCM encrypted raw ticket token (for same-link resend — ADR 0006).
  // Null for Mode B (agency) attendees; null for unissued Mode A attendees.
  token_enc           String?
  // Agency-provided QR payload preserved as source of truth for import.
  qr_payload          String?
  external_uuid       String?
  // Non-guessable public URL key for Mode B ticket/QR pages (/t/:slug/a/:ref) — not Attendee.id.
  public_ref          String?             @unique
  ticket_type         String?
  // Enforces ticket_type at the DB level, on top of the app-level catalog check every write path
  // already does - defense-in-depth for data written outside those paths (raw SQL, a restored
  // backup). NULL ticket_type is exempt (composite FKs don't check rows where either column is
  // NULL), so an unset type is unaffected. onDelete: Restrict matches the app's own
  // type_in_use check (ticket-types-routes.ts) - a type already blocked from deletion while any
  // attendee has it now also can't be deleted out from under one via a direct DB delete.
  ticket_type_catalog TicketType?         @relation(fields: [event_id, ticket_type], references: [event_id, key], onDelete: Restrict, onUpdate: Cascade)
  company             String?
  department          String?
  // Descriptive import/form fields (company, department, shirt_size) — ADR 0010.
  custom_data         Json?
  status              String              @default("registered")
  // RSVP lifecycle (ADR 0033) — distinct from check-in and Attendee.status.
  rsvp_status         String              @default("none")
  rsvp_updated_at     DateTime?
  rsvp_source         String?
  // Set atomically on first VALID check-in (CAS WHERE admitted_at IS NULL).
  // Null = not yet admitted. Reset only by explicit admin revert action.
  admitted_at         DateTime?
  admitted_by         String?
  created_at          DateTime            @default(now())
  // Acting admin's IANA timezone at the moment this row was created (manual add / import
  // commit) — null for rows predating this column or created outside a browser request.
  client_timezone     String?
  updated_at          DateTime            @default(now()) @updatedAt
  email_deliveries    EmailDelivery[]
  wallet_pass         WalletPass?
  check_ins           CheckIn[]
  item_states         AttendeeItemState[]
  notes               AttendeeNote[]
  action_logs         AttendeeActionLog[]

  @@unique([event_id, email])
  // Enforce agency-UUID uniqueness per event for idempotent re-import.
  // NULL external_uuid is allowed for multiple rows (NULLs are not equal in SQL).
  @@unique([event_id, external_uuid])
  // Agency QR payloads must resolve to at most one attendee per event.
  // NULL qr_payload is allowed for multiple internal attendees.
  @@unique([event_id, qr_payload])
  // Composite key for CheckIn FK — attendee_id + event_id must match the same row.
  @@unique([id, event_id])
  @@index([external_uuid])
}

model WalletPass {
  id            String   @id @default(cuid())
  attendee_id   String   @unique
  attendee      Attendee @relation(fields: [attendee_id], references: [id])
  pass_type_id  String
  serial_number String
  auth_token    String
  pass_url      String?
  status        String   @default("active")
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
}

model EmailDelivery {
  id                      String        @id @default(cuid())
  organization_id         String
  organization            Organization  @relation(fields: [organization_id], references: [id], onDelete: Restrict)
  event_id                String
  event                   Event         @relation(fields: [event_id], references: [id], onDelete: Restrict)
  attendee_id             String
  attendee                Attendee      @relation(fields: [attendee_id], references: [id])
  purpose                 String        @default("initial") // "initial" | "resend"
  batch_id                String?
  template_id             String?
  template                MailTemplate? @relation(fields: [template_id], references: [id], onDelete: SetNull)
  // The template's label at send time, independent of the live MailTemplate row - template_id
  // is SetNull'd if that row is later deleted (templates may be deleted even once used, see
  // multi-template.test.ts), which would otherwise make a deleted-template send indistinguishable
  // from a genuine default-template send. Null when no custom template was used (builtin default).
  // Rows predating this column are backfilled from their still-live MailTemplate join (see
  // backfill-email-delivery-template-label-snapshot.ts) - null here for a pre-existing row means
  // its template was already deleted before the backfill ran, which is unrecoverable.
  template_label_snapshot String?
  provider                String
  provider_message_id     String?
  status                  String        @default("queued")
  error_code              String?
  error                   String?
  retryable               Boolean?
  attempts                Int           @default(1)
  recipient_email         String?
  rendered_subject        String?
  rendered_html           String?       @db.Text
  queued_at               DateTime      @default(now())
  attempted_at            DateTime?
  accepted_at             DateTime?
  sent_at                 DateTime?
  delivered_at            DateTime?
  failed_at               DateTime?
  viewed_at               DateTime?
  opened_at               DateTime?
  clicked_at              DateTime?
  created_at              DateTime      @default(now())
  // Triggering admin's IANA timezone at send/resend time — null for rows predating this
  // column or created outside a browser request.
  client_timezone         String?
  // Triggering admin's user/session id at send/resend time — null for rows predating these
  // columns or created outside a browser request (e.g. an automated initial send). Durable
  // independently of the best-effort bulk-action audit log (see writeBulkActionLog callers):
  // this is written in the same call that queues the row, not a separate fire-and-forget write.
  actor_user_id           String?
  session_id              String?
  updated_at              DateTime      @updatedAt

  @@index([organization_id])
  @@index([event_id, created_at(sort: Desc)])
  @@index([attendee_id, event_id, status])
}

model CheckIn {
  id            String   @id @default(cuid())
  attendee_id   String
  event_id      String
  attendee      Attendee @relation(fields: [attendee_id, event_id], references: [id, event_id])
  event         Event    @relation(fields: [event_id], references: [id])
  checked_in_at DateTime @default(now())
  // CheckInStatus values — see src/status.ts.
  status        String   @default("VALID")
  checked_in_by String?
  source        String?
  notes         String?
  device_id     String?
  // No FK, matching checked_in_by above - a session can be purged after its own retention
  // window without invalidating this row. Lets Reports resolve the *current* device_label for
  // a still-live session instead of only the frozen device_id snapshot (see
  // loadDeviceIdsByAttendee), so a superadmin's later typo fix is reflected on past check-ins too.
  session_id    String?
  created_at    DateTime @default(now())

  @@index([event_id, checked_in_at(sort: Desc), id(sort: Desc)])
}

// Operational items configured per event (giftbag, badge, headset) — ADR 0010.
model EventItem {
  id          String   @id @default(cuid())
  event_id    String
  event       Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  key         String
  label       String
  description String?
  type        String   @default("item")
  enabled     Boolean  @default(true)
  icon        String?  @db.VarChar(64)
  config      Json?
  created_at  DateTime @default(now())
  updated_at  DateTime @updatedAt

  item_states AttendeeItemState[]

  @@unique([event_id, key])
  @@index([event_id])
}

// Current operational item state per attendee (fast UI read) — ADR 0010.
model AttendeeItemState {
  id            String    @id @default(cuid())
  attendee_id   String
  event_item_id String
  attendee      Attendee  @relation(fields: [attendee_id], references: [id], onDelete: Cascade)
  event_item    EventItem @relation(fields: [event_item_id], references: [id], onDelete: Cascade)
  state         String    @default("pending")
  updated_at    DateTime  @updatedAt
  updated_by    String?

  @@unique([attendee_id, event_item_id])
  @@index([attendee_id])
  @@index([event_item_id, state])
}

// Append-only operator notes — author + timestamp preserved — ADR 0010.
model AttendeeNote {
  id             String   @id @default(cuid())
  attendee_id    String
  event_id       String
  attendee       Attendee @relation(fields: [attendee_id], references: [id], onDelete: Cascade)
  event          Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  author_user_id String
  body           String   @db.Text
  created_at     DateTime @default(now())

  @@index([attendee_id, created_at(sort: Desc)])
  @@index([event_id])
}

// Append-only audit log for event-day ops — ADR 0010.
model AttendeeActionLog {
  id              String    @id @default(cuid())
  event_id        String
  attendee_id     String?
  event           Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  attendee        Attendee? @relation(fields: [attendee_id], references: [id], onDelete: Cascade)
  action_type     String
  actor_user_id   String?
  session_id      String?
  device_id       String?
  ip              String?
  metadata        Json?
  created_at      DateTime  @default(now())
  // Actor's IANA timezone at write time — null for rows predating this column or written
  // outside a browser request. See OpsAuditContext.timezone.
  client_timezone String?

  @@index([event_id, created_at(sort: Desc)])
  @@index([attendee_id, created_at(sort: Desc)])
}

// Instance/org-scoped admin audit (ADR 0031) — superadmin settings, sessions, archiving.
model AdminAuditLog {
  id              String   @id @default(cuid())
  organization_id String?
  actor_user_id   String
  action_type     String
  metadata        Json?
  ip              String?
  session_id      String?
  created_at      DateTime @default(now())
  // Actor's IANA timezone at write time — null for rows predating this column or written
  // outside a browser request. Mirrors AttendeeActionLog.client_timezone.
  actor_timezone  String?

  @@index([organization_id, created_at(sort: Desc)])
}

// Durable auth/security-event trail (issue #473) — logins, MFA, OIDC, access-denied. Distinct
// from AdminAuditLog: actor_user_id there is required/non-null, but a failed login against a
// non-existent email has no real user to attribute. user_id is intentionally nullable here for
// exactly that case (enumeration-safe: never reveals whether an email exists). Before this model,
// these events only reached stdout (container log driver) and an in-memory 1000-entry ring buffer
// wiped on every restart — see packages/auth/src/audit.ts and DATA-PROTECTION.md. Product-automated
// 30-day retention (packages/auth/src/retention.ts, purgeSecurityAuditLog), unlike AdminAuditLog's
// operator-run IP-retention convention, since this table can grow quickly under attack.
model SecurityAuditLog {
  id         String   @id @default(cuid())
  event_type String
  user_id    String?
  ip         String?
  metadata   Json?
  created_at DateTime @default(now())

  @@index([event_type, created_at(sort: Desc)])
  @@index([user_id])
}

// Per-scope mailer configuration (ADR 0005, ADR 0006).
// scope_type = "organization" | "event". Secrets stored encrypted via @admitto/crypto.
model MailSettings {
  id         String @id @default(cuid())
  scope_type String // "organization" | "event"
  scope_id   String

  // Provider (plain)
  provider String? // "graph" | "smtp" | "powerautomate" | "export_only"

  // SMTP non-secret fields
  host                    String?
  port                    Int?
  secure                  Boolean?
  user                    String?
  require_tls             Boolean?
  tls_reject_unauthorized Boolean?
  helo_name               String?
  pool                    Boolean?
  max_connections         Int?
  max_messages            Int?
  rate_limit_per_minute   Int?
  connection_timeout      Int?
  greeting_timeout        Int?
  socket_timeout          Int?

  // Graph non-secret fields
  mailbox            String?
  tenant_id          String?
  client_id          String?
  save_to_sent_items Boolean?

  // Shared sender model (non-secret)
  from_address        String?
  from_name           String?
  reply_to            String?
  envelope_from       String?
  allowed_from_domain String?

  // Encrypted secrets (AES-256-GCM via @admitto/crypto — never store plaintext)
  smtp_password_enc       String?
  graph_client_secret_enc String?
  power_automate_key_enc  String?
  power_automate_url_enc  String? // PA url is treated as a secret (contains sig token)

  created_at DateTime @default(now())
  updated_at DateTime @updatedAt

  @@unique([scope_type, scope_id])
}

// Event-scoped IMAP bounce / NDR ingest (ADR 0039; event-only correlation).
model BounceIngestSettings {
  id                     String    @id @default(cuid())
  event_id               String    @unique
  event                  Event     @relation(fields: [event_id], references: [id], onDelete: Cascade)
  imap_host              String?
  imap_port              Int?
  imap_username          String?
  imap_password_enc      String? // used when reuse_smtp_credentials = false
  reuse_smtp_credentials Boolean   @default(false)
  folders                Json? // string[], e.g. ["INBOX", "Junk Email"]
  poll_interval_minutes  Int?      @default(5)
  enabled                Boolean   @default(false)
  // Written by bounce-ingest (ingestBounces), not by Test connection / admin PUT.
  last_run_at            DateTime?
  last_run_ok            Boolean?
  last_run_summary       Json? // compact IngestSummary snapshot for this event
  created_at             DateTime  @default(now())
  updated_at             DateTime  @updatedAt
}

// Dedup marker for processed IMAP messages (source of truth — not IMAP \Seen).
model BounceIngestProcessedUid {
  id           String   @id @default(cuid())
  event_id     String
  event        Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  folder       String
  uid          String
  processed_at DateTime @default(now())

  @@unique([event_id, folder, uid])
  @@index([event_id, folder])
}

// Recent automatic bounce-ingest runs per event (short retention; last-run also on settings).
model BounceIngestRun {
  id         String   @id @default(cuid())
  event_id   String
  event      Event    @relation(fields: [event_id], references: [id], onDelete: Cascade)
  ran_at     DateTime @default(now())
  ok         Boolean
  summary    Json // same compact shape as BounceIngestSettings.last_run_summary

  @@index([event_id, ran_at(sort: Desc)])
}

// Per-scope mail template storage (plain text — not encrypted).
model MailTemplate {
  id                     String          @id @default(cuid())
  scope_type             String // "organization" | "event"
  scope_id               String
  name                   String          @default("ticket")
  label                  String          @default("Ticket email")
  subject_template       String
  body_template          String          @db.Text
  template_format        String // "mjml" | "html"
  compiled_html_template String          @db.Text
  created_at             DateTime        @default(now())
  updated_at             DateTime        @updatedAt
  email_deliveries       EmailDelivery[]

  @@unique([scope_type, scope_id, name])
}

model User {
  id                   String             @id @default(cuid())
  email                String             @unique
  password_hash        String?
  display_name         String?
  preferred_locale     String? // IETF BCP 47 tag, e.g. "pl-PL"; null = browser default
  // Internal contact use only (not shown on tickets/public pages). Dial code includes the "+",
  // e.g. "+48"; phone_number is the local number with no formatting/validation beyond digits.
  phone_country_code   String?
  phone_number         String?
  is_active            Boolean            @default(true)
  must_change_password Boolean            @default(false)
  // Consecutive failed login attempts, tracked only for admin/superadmin accounts (P0 security
  // review) to alert when a privileged account is under attack; reset to 0 on a successful
  // login or once the streak crosses the alert threshold (see auth.login.repeated_failures).
  failed_login_streak  Int                @default(0)
  created_at           DateTime           @default(now())
  updated_at           DateTime           @updatedAt
  sessions             Session[]
  role_assignments     RoleAssignment[]
  oidc_role_grants     OidcRoleGrant[]
  mfa_methods          UserMfaMethod[]
  trusted_devices      TrustedDevice[]
  external_identities  ExternalIdentity[]
}

model Session {
  id           String    @id @default(cuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash   String    @unique
  // full | mfa_pending | enrollment_required | backup_codes_required — only full grants protected routes (ADR 0011).
  stage        String    @default("full")
  // local | oidc — IdP-authenticated sessions skip local TOTP policy (prompt 16b).
  auth_method  String    @default("local")
  // Optional UI context only — not an authorization source (ADR 0011).
  scope        String?
  device_label String?
  ip           String?
  user_agent   String?
  created_at   DateTime  @default(now())
  last_seen_at DateTime  @default(now())
  expires_at   DateTime
  revoked_at   DateTime?

  @@index([user_id])
  @@index([expires_at])
}

// MFA methods per user — seam for totp, webauthn (future), recovery codes (ADR 0011).
model UserMfaMethod {
  id                           String    @id @default(cuid())
  user_id                      String
  user                         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  type                         String // "totp" | "webauthn" | "recovery"
  secret_enc                   String? // AES-256-GCM encrypted TOTP secret
  credential_hash              String? // argon2id hash for recovery codes
  label                        String? // e.g. "emergency" for break-glass one-time codes
  confirmed_at                 DateTime?
  last_used_at                 DateTime?
  /// When the user acknowledged the backup recovery codes for this TOTP method.
  /// Defaults to row-creation time; the live enrollment flow explicitly clears it at
  /// TOTP confirmation so the user must pass the backup-codes step before a full
  /// session is granted (IAM-002). Re-set when the codes are acknowledged.
  backup_codes_acknowledged_at DateTime? @default(now())
  /// Last accepted TOTP time step (RFC 6238) — replay protection via otplib `afterTimeStep`.
  last_totp_time_step          Int?
  created_at                   DateTime  @default(now())

  @@index([user_id, type])
}

// Trusted-device tokens (hash only) — skip TOTP on known devices (ADR 0011).
model TrustedDevice {
  id           String    @id @default(cuid())
  user_id      String
  user         User      @relation(fields: [user_id], references: [id], onDelete: Cascade)
  token_hash   String    @unique
  label        String?
  ip           String?
  user_agent   String?
  created_at   DateTime  @default(now())
  last_used_at DateTime  @default(now())
  expires_at   DateTime
  revoked_at   DateTime?

  @@index([user_id])
  @@index([expires_at])
}

// Instance-level settings — superadmin-editable later; env-overridable now (ADR 0011).
model SystemSettings {
  key        String   @id
  value_json String   @db.Text
  updated_at DateTime @updatedAt
}

model RoleAssignment {
  id         String   @id @default(cuid())
  user_id    String
  user       User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  role       String // "superadmin" | "admin" | "operator"
  scope_type String // "instance" | "organization" | "event"
  scope_id   String? // null for instance scope
  created_at DateTime @default(now())

  oidc_role_grants OidcRoleGrant[]
  // Partial UNIQUE indexes (scoped + instance NULL) live in migration SQL — not expressible via @@unique.

  @@index([user_id])
  @@index([scope_type, scope_id])
}

// OIDC / external identity providers (prompt 16b; cloudflare_access reserved for 16c).
model IdentityProvider {
  id                     String   @id @default(cuid())
  provider_type          String   @default("oidc") // "oidc" | "cloudflare_access"
  issuer                 String
  client_id              String
  client_secret_enc      String?
  authorization_endpoint String
  token_endpoint         String
  jwks_uri               String
  userinfo_endpoint      String?
  claim_email            String   @default("email")
  claim_name             String   @default("name")
  claim_groups           String   @default("groups")
  enabled                Boolean  @default(false)
  display_name           String
  login_button_label     String?
  created_at             DateTime @default(now())
  updated_at             DateTime @updatedAt

  external_identities ExternalIdentity[]
  group_role_mappings OidcGroupRoleMapping[]
  oidc_role_grants    OidcRoleGrant[]
  oidc_auth_states    OidcAuthState[]

  @@unique([issuer, client_id])
}

// Linked external subject → local User (JIT or explicit link).
model ExternalIdentity {
  id            String           @id @default(cuid())
  provider_id   String
  provider      IdentityProvider @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  subject       String
  user_id       String
  user          User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  email         String?
  name          String?
  groups        String[]         @default([])
  linked_at     DateTime         @default(now())
  last_login_at DateTime?

  @@unique([provider_id, subject])
  @@index([user_id])
}

// Grafana-style group → role rules (default empty; superadmin-configured).
model OidcGroupRoleMapping {
  id          String           @id @default(cuid())
  provider_id String
  provider    IdentityProvider @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  group       String
  role        String
  scope_type  String
  scope_id    String           @default("")
  created_at  DateTime         @default(now())

  @@unique([provider_id, group, role, scope_type, scope_id])
  @@index([provider_id])
}

// Roles granted by a specific OIDC provider login — demotion only revokes tracked grants.
model OidcRoleGrant {
  id                 String           @id @default(cuid())
  user_id            String
  user               User             @relation(fields: [user_id], references: [id], onDelete: Cascade)
  provider_id        String
  provider           IdentityProvider @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  role               String
  scope_type         String
  scope_id           String?
  role_assignment_id String
  role_assignment    RoleAssignment   @relation(fields: [role_assignment_id], references: [id], onDelete: Cascade)
  created_at         DateTime         @default(now())
  // Partial UNIQUE indexes (scoped + instance NULL) live in migration SQL — not expressible via @@unique.

  @@index([provider_id, user_id])
  @@index([role_assignment_id])
}

// Short-lived OAuth state (PKCE, CSRF, nonce) — single-use.
model OidcAuthState {
  id              String           @id @default(cuid())
  provider_id     String
  provider        IdentityProvider @relation(fields: [provider_id], references: [id], onDelete: Cascade)
  state           String           @unique
  nonce           String
  code_verifier   String
  redirect_next   String?
  link_user_id    String?
  link_step_up_at DateTime?
  expires_at      DateTime
  consumed_at     DateTime?
  created_at      DateTime         @default(now())

  @@index([expires_at])
  @@index([provider_id])
}
