{
  "name": "@admitto/mailer",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto mailer — one interface, pluggable transports (Graph, SMTP, Power Automate, export_only)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/shared",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "send": "tsx src/cli.ts"
  },
  "dependencies": {
    "@admitto/shared": "*",
    "nodemailer": "^9.0.5",
    "undici": "^8.7.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/nodemailer": "^8.0.1",
    "tsx": "^4.23.10",
    "typescript": "^7.0.2",
    "vitest": "4.1.11"
  }
}
