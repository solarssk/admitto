{
  "name": "@admitto/mailer",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto mailer — one interface, pluggable transports (Graph, SMTP, Power Automate, export_only)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "send": "tsx src/cli.ts"
  },
  "dependencies": {
    "@admitto/shared": "*",
    "nodemailer": "^9.0.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^22.19.20",
    "@types/nodemailer": "^6.4.15",
    "tsx": "^4.16.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
