# Admitto mailer — configuration via env (will be replaced by UI Settings).
# Choose ONE provider; fill in only its section.

# graph | smtp | powerautomate
MAILER_PROVIDER=powerautomate

# ---------- POWER AUTOMATE (HTTP webhook) ----------
MAILER_PA_URL=
MAILER_PA_KEY=

# ---------- SMTP ----------
MAILER_SMTP_HOST=smtp.office365.com
MAILER_SMTP_PORT=587
MAILER_SMTP_SECURE=false
MAILER_SMTP_USER=
MAILER_SMTP_PASSWORD=
MAILER_SMTP_FROM=

# ---------- MICROSOFT GRAPH (app-only / client credentials) ----------
MAILER_GRAPH_TENANT_ID=
MAILER_GRAPH_CLIENT_ID=
MAILER_GRAPH_CLIENT_SECRET=
MAILER_GRAPH_SENDER=
MAILER_GRAPH_SAVE_TO_SENT=true
