{
  "name": "@admitto/mail-delivery",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto mail delivery orchestration — issue, render, send, dedup, retry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/shared -w @admitto/crypto -w @admitto/db -w @admitto/location -w @admitto/wallet -w @admitto/mail-templates -w @admitto/tickets -w @admitto/mailer -w @admitto/mailer-config",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "precli": "npm run build -w @admitto/shared -w @admitto/crypto -w @admitto/db -w @admitto/tickets -w @admitto/mailer -w @admitto/mailer-config -w @admitto/mail-templates -w @admitto/mail-delivery",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@admitto/crypto": "*",
    "@admitto/db": "*",
    "@admitto/location": "*",
    "@admitto/mail-templates": "*",
    "@admitto/mailer": "*",
    "@admitto/mailer-config": "*",
    "@admitto/shared": "*",
    "@admitto/tickets": "*",
    "iconv-lite": "^0.6.3",
    "imapflow": "^1.7.0",
    "libmime": "^5.4.1",
    "libqp": "^2.1.1"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/libmime": "^5.3.0",
    "@types/node": "^24.0.0",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
