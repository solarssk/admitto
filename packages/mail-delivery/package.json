{
  "name": "@admitto/mail-delivery",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto mail delivery orchestration — issue, render, send, dedup, retry",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@admitto/crypto": "*",
    "@admitto/db": "*",
    "@admitto/mail-templates": "*",
    "@admitto/mailer": "*",
    "@admitto/mailer-config": "*",
    "@admitto/tickets": "*"
  },
  "devDependencies": {
    "@prisma/client": "^5.17.0",
    "@types/node": "^22.19.20",
    "prisma": "^5.17.0",
    "tsx": "^4.16.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.8"
  }
}
