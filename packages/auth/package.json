{
  "name": "@admitto/auth",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto auth — local accounts, sessions, RBAC capability helpers",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "default": "./dist/constants.js"
    },
    "./audit": {
      "types": "./dist/audit.d.ts",
      "default": "./dist/audit.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./cli-helpers": {
      "types": "./dist/cli-helpers.d.ts",
      "default": "./dist/cli-helpers.js"
    },
    "./password-strength": {
      "types": "./dist/password-strength.d.ts",
      "default": "./dist/password-strength.js"
    },
    "./password-strength-script": {
      "types": "./dist/password-strength-script.d.ts",
      "default": "./dist/password-strength-script.js"
    },
    "./password-strength-fixtures": {
      "types": "./dist/password-strength-fixtures.d.ts",
      "default": "./dist/password-strength-fixtures.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/shared -w @admitto/crypto -w @admitto/db -w @admitto/mail-templates -w @admitto/tickets",
    "precoverage": "npm run pretest",
    "test": "vitest run --project unit && vitest run --project auth-integration",
    "coverage": "vitest run --coverage -c vitest.unit.config.ts && vitest run --coverage -c vitest.integration.config.ts",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project auth-integration",
    "precli": "npm run build -w @admitto/shared -w @admitto/crypto -w @admitto/db -w @admitto/mail-templates -w @admitto/tickets -w @admitto/auth",
    "cli": "node dist/cli.js"
  },
  "dependencies": {
    "@admitto/crypto": "*",
    "@admitto/db": "*",
    "@admitto/mail-templates": "*",
    "@admitto/shared": "*",
    "@admitto/tickets": "*",
    "argon2": "^0.44.0",
    "jose": "^6.0.11",
    "otplib": "^13.4.1",
    "undici": "^8.7.0"
  },
  "devDependencies": {
    "@prisma/client": "^5.17.0",
    "@types/node": "^24.0.0",
    "jsdom": "^26.1.0",
    "prisma": "^5.17.0",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  }
}
