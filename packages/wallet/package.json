{
  "name": "@admitto/wallet",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto wallet domain — WalletPassProvider abstraction (ADR 0009, ADR 0041)",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "dependencies": {
    "@admitto/crypto": "*",
    "@admitto/db": "*",
    "@admitto/shared": "*"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/shared",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
