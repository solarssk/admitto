{
  "name": "@admitto/tickets",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto ticket domain — token generation, hashing, QR, and resolver",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attendees-export": {
      "types": "./dist/attendees-export.d.ts",
      "default": "./dist/attendees-export.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/crypto && npm run build -w @admitto/db && npm run build -w @admitto/mail-templates",
    "precoverage": "npm run build -w @admitto/crypto && npm run build -w @admitto/db && npm run build -w @admitto/mail-templates",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@admitto/crypto": "*",
    "@admitto/db": "*",
    "@admitto/mail-templates": "*",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@prisma/client": "^5.17.0",
    "@types/node": "^24.0.0",
    "@types/qrcode": "^1.5.5",
    "prisma": "^5.17.0",
    "typescript": "^6.0.3",
    "vitest": "4.1.9"
  }
}
