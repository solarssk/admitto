{
  "name": "@admitto/tickets",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto ticket domain — token generation, hashing, QR, and resolver",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./attendees-export": {
      "types": "./dist/attendees-export.d.ts",
      "default": "./dist/attendees-export.js"
    },
    "./attendees-export-pdf": {
      "types": "./dist/attendees-export-pdf.d.ts",
      "default": "./dist/attendees-export-pdf.js"
    },
    "./attendees-export-xlsx": {
      "types": "./dist/attendees-export-xlsx.d.ts",
      "default": "./dist/attendees-export-xlsx.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/crypto && npm run build -w @admitto/db && npm run build -w @admitto/mail-templates",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@admitto/crypto": "*",
    "@admitto/db": "*",
    "@admitto/mail-templates": "*",
    "dejavu-fonts-ttf": "^2.37.3",
    "exceljs": "^4.4.0",
    "pdfkit": "^0.19.1",
    "qrcode": "^1.5.3"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.5",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
