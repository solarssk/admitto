{
  "name": "@admitto/mailer-config",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto mailer config scope resolver — per-field env > event > org > default precedence",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/shared -w @admitto/crypto -w @admitto/db -w @admitto/mailer",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@admitto/crypto": "*",
    "@admitto/db": "*",
    "@admitto/mailer": "*"
  },
  "devDependencies": {
    "@prisma/client": "^7.9.1",
    "@types/node": "^26.2.0",
    "prisma": "^7.9.1",
    "typescript": "^7.0.2",
    "vitest": "4.1.10"
  }
}
