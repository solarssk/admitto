{
  "name": "admitto",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto — event access gateway (attendee import, QR tickets, wallet passes, M365 mail, check-in)",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint 'packages/*/src/**/*.ts'"
  },
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@typescript-eslint/parser": "8.60.1",
    "eslint": "10.4.1",
    "eslint-plugin-security": "4.0.0"
  }
}
