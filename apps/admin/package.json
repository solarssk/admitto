{
  "name": "@admitto/admin",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto staff SPA — admin shell + operator check-in entry",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "pretest": "npm run build -w @admitto/db && npm run build -w @admitto/shared && npm run build -w @admitto/location && npm run build -w @admitto/wallet && npm run build -w @admitto/mail-templates && npm run build -w @admitto/tickets && npm run build -w @admitto/ui && npm run build -w @admitto/auth",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "preview": "vite preview"
  },
  "dependencies": {
    "@admitto/db": "*",
    "@admitto/location": "*",
    "@admitto/mail-templates": "*",
    "@admitto/shared": "*",
    "@admitto/tickets": "*",
    "@admitto/ui": "*",
    "@admitto/wallet": "*",
    "@tabler/icons-webfont": "3.46.0",
    "@zxing/browser": "^0.2.0",
    "countries-list": "^3.4.1",
    "country-flag-emoji-polyfill": "^0.1.10",
    "leaflet": "^1.9.4",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-image-crop": "^11.1.2",
    "react-router": "^8.3.0"
  },
  "devDependencies": {
    "@admitto/auth": "*",
    "@testing-library/react": "^16.3.0",
    "@types/leaflet": "^1.9.22",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "8.2.0",
    "vitest": "4.1.10"
  }
}
