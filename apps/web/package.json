{
  "name": "@admitto/web",
  "version": "0.0.1",
  "private": true,
  "description": "Admitto public web — ticket page",
  "type": "module",
  "main": "./dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -R src/assets dist/src/assets",
    "pretest": "npm run build -w @admitto/shared && npm run build -w @admitto/ui && npm run build -w @admitto/admin",
    "precoverage": "npm run pretest",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "test:unit": "vitest run --project web-unit",
    "test:integration": "vitest run --project integration",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "NODE_ENV=development node --import tsx --env-file=.env src/index.ts",
    "start": "node dist/src/index.js"
  },
  "dependencies": {
    "@admitto/auth": "*",
    "@admitto/crypto": "*",
    "@admitto/db": "*",
    "@admitto/import": "*",
    "@admitto/location": "*",
    "@admitto/mail-delivery": "*",
    "@admitto/mail-templates": "*",
    "@admitto/mailer": "*",
    "@admitto/shared": "*",
    "@admitto/storage": "*",
    "@admitto/tickets": "*",
    "@admitto/ui": "*",
    "@admitto/wallet": "*",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/inter": "^5.2.5",
    "@fontsource/manrope": "^5.3.0",
    "@fontsource/space-grotesk": "^5.3.0",
    "@hono/node-server": "^2.0.12",
    "@prisma/client": "^7.9.1",
    "@tabler/icons-webfont": "3.46.0",
    "dejavu-fonts-ttf": "^2.37.3",
    "exceljs": "^4.4.0",
    "geo-tz": "^8.1.8",
    "hono": "^4.13.0",
    "ip-location-api": "5.0.2",
    "pdfkit": "^0.19.1",
    "redis": "^6.1.0",
    "sharp": "^0.35.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@testcontainers/redis": "^12.1.0",
    "@types/node": "^24.0.0",
    "@types/pdfkit": "^0.17.6",
    "jose": "^6.2.5",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "undici": "^8.7.0",
    "vitest": "4.1.10"
  }
}
