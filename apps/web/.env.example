DATABASE_URL=postgresql://admitto:admitto@localhost:5432/admitto

# Optional shared store for cross-instance rate limiting on /t and /q.
# Omit to use in-memory limiter (default for local dev/tests).
REDIS_URL=redis://localhost:6379

# AES-256-GCM master key for at-rest encryption (ADR 0006).
# Required in non-development environments; resolves lazily at first use.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Absolute base URL for public ticket links and QR payloads.
# Required in production. Dev fallback: http://localhost:3000
BASE_URL=https://tickets.example.com

# Local lab only (ignored when NODE_ENV=production): allow SMTP/Power Automate hosts that are
# or resolve to loopback, RFC1918/IPv6-private, link-local, cloud metadata, or unspecified
# addresses - including literal hosts like 192.168.1.10. Applied at config validation and at
# connect time. Never enable in production. Default: unset/false (SSRF guard blocks them).
# ALLOW_PRIVATE_MAIL_DESTINATIONS=false

# High-entropy shared operator secret — emergency break-glass only when ALLOW_CHECKIN_BEARER=true.
# Generate with: openssl rand -hex 32
CHECKIN_OPERATOR_TOKEN=

# Emergency: re-enable ADR 0003 Bearer on /api/checkin/* (default false). Warns at boot outside development.
ALLOW_CHECKIN_BEARER=false

# Enables GET /readyz (detailed readiness for Uptime Kuma). Send as Authorization: Bearer <token> or X-Ops-Token.
# Minimum 32 characters. When unset or too short, /readyz returns 404 (disabled). Generate with: openssl rand -hex 32
OPS_HEALTH_TOKEN=

# Reverse proxy overwrites forwarded headers from clients (required in production behind nginx/traefik).
# When false/unset: rate limits and audit use the direct connection IP; CSRF checks use the request URL.
# When true AND the request's direct peer is in TRUSTED_PROXY_CIDRS: X-Forwarded-For (client IP),
# X-Forwarded-Proto/Host (CSRF origin, cookie Secure flag) are honoured. Peer check defaults to
# loopback-only (127.0.0.1/32,::1/128) if TRUSTED_PROXY_CIDRS is unset.
# TRUST_PROXY=true
# TRUSTED_PROXY_CIDRS=127.0.0.1/32,::1/128

# IP→country lookup for Audit log/Security log/Sessions (apps/web/src/rate-limit/ip-location.ts).
# ILA_IP_LOCATION_DB=user selects the offline, no-account-needed ip-location-db "user" dataset
# instead of ip-location-api's default MaxMind GeoLite2 mode. Docker images bake the dataset in at
# build time (see Dockerfile); for local dev, the first lookup fetches it once into ILA_DATA_DIR
# (a few MB, one-time). Keep ILA_AUTO_UPDATE=false so nothing makes its own outbound update call.
ILA_IP_LOCATION_DB=user
ILA_DATA_DIR=./data/geoip
ILA_AUTO_UPDATE=false

# Session TTL defaults (optional overrides, milliseconds) — env locks for SystemSettings.
# SESSION_TTL_OPERATOR_MS=43200000
# For deployments where OIDC group mappings grant admin/superadmin roles, set
# admin TTL to 8h or less so IdP removals have a bounded stale-session window.
# SESSION_TTL_ADMIN_MS=28800000
# If unset, the application default is 43200000 (12 hours) for both roles.

# Idle timeout — ends a `full` session after this much inactivity, well before the absolute
# TTL above is reached (milliseconds). Must not exceed the matching TTL above (rejected by the
# admin API). If unset, the application default is 1800000 (30 min) admin / 7200000 (2h) operator.
# SESSION_IDLE_TIMEOUT_ADMIN_MS=1800000
# SESSION_IDLE_TIMEOUT_OPERATOR_MS=7200000

# IANA timezone for event calendar dates and export admitted_at (e.g. Europe/Warsaw).
ADMITTO_DEFAULT_EVENT_TIMEZONE=Europe/Warsaw

# MFA / trusted device (optional — override SystemSettings keys).
# TRUSTED_DEVICE_DAYS=30
# MFA_REQUIRED_ROLES=admin,superadmin

# OIDC (Authentik) — optional dev seed; production config via Settings → Identity (superadmin UI).
# OIDC_ENABLED=false
# OIDC_ISSUER=https://auth.example.com/application/o/admitto/
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_DISPLAY_NAME=Corporate SSO

# Cloudflare Access (prompt 16c) — optional env locks; primary config via Settings → Identity (superadmin UI).
# CF_ACCESS_ENABLED=false
# CF_ACCESS_TEAM_DOMAIN=https://<team>.cloudflareaccess.com
# CF_ACCESS_AUD=your-application-audience-tag
# CF_ACCESS_PROTECTED_PREFIXES=["/admin","/api/admin"]

# Event Settings "Location" tab — Leaflet map tiles + Nominatim geocoding (both optional).
# Default tiles are CARTO Voyager (public CDN, no API key); geocoding defaults to Nominatim.
# LOCATION_MAPS_ENABLED=true
# MAP_TILE_URL must be CSP-compatible with the staff SPA (https: in production; http://localhost
# only in development). Plain-HTTP remote tile URLs are ignored and the default HTTPS tiles are used.
# MAP_TILE_URL=https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}.png
# MAP_TILE_ATTRIBUTION=&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a> contributors &copy; <a href="https://carto.com/attributions">CARTO</a>
# MAP_TILE_MAX_ZOOM=19
# To use OSM's own tiles instead: MAP_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png

# GEOCODING_PROVIDER=nominatim
# GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
# GEOCODING_TIMEOUT_MS=5000
# No MAPS_USER_AGENT: the Nominatim User-Agent is built from Settings → General →
# Support contact instead — see docs/wiki for details.
