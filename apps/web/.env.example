DATABASE_URL=postgresql://admitto:admitto@localhost:5432/admitto

# Optional shared store for cross-instance rate limiting on /t and /q.
# Omit to use in-memory limiter (default for local dev/tests).
REDIS_URL=redis://localhost:6379

# AES-256-GCM master key for at-rest encryption (ADR 0006).
# Required in non-development environments; resolves lazily at first use.
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=

# Absolute base URL for public ticket links and QR payloads.
# Required in production. Dev fallback: http://localhost:3000
BASE_URL=https://tickets.example.com

# High-entropy shared operator secret for the /api/checkin/* gate (ADR 0003).
# Temporary: single shared token; will be replaced by per-operator auth.
# Generate with: openssl rand -hex 32
CHECKIN_OPERATOR_TOKEN=

# Session TTL defaults (optional overrides, milliseconds).
# SESSION_TTL_OPERATOR_MS=43200000
# SESSION_TTL_ADMIN_MS=604800000
